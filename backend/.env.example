# Application Settings
APP_NAME=Study Platform API
APP_VERSION=1.0.0
DEBUG=True

# Security Settings
# IMPORTANT: Generate a new secret key for production using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-CHANGE-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database Settings
# For SQLite (development):
DATABASE_URL=sqlite:///./cloudplus_study.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Redis (optional, for caching and rate limiting)
REDIS_URL=redis://localhost:6379
USE_REDIS=False

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Password Policy
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=True
REQUIRE_LOWERCASE=True
REQUIRE_DIGIT=True
REQUIRE_SPECIAL_CHAR=False

# Production Settings
# Set these to more restrictive values in production:
# DEBUG=False
# ALLOWED_ORIGINS=https://yourdomain.com
# USE_REDIS=True
# RATE_LIMIT_PER_MINUTE=30
